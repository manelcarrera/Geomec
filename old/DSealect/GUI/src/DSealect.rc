IDD_FormationDefinition DIALOGEX 0, 0, 209, 366
STYLE DS_SETFONT | DS_MODALFRAME | WS_CHILD
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         "Onshore definition",IDC_optOnshoreDefinition,"Button",BS_AUTORADIOBUTTON | WS_GROUP,14,26,84,10,WS_EX_TRANSPARENT
    EDITTEXT        IDC_ebMeanGroundLevel,110,39,45,12,ES_AUTOHSCROLL
    CONTROL         "Offshore definition",IDC_optOffshoreDefinition,"Button",BS_AUTORADIOBUTTON,14,57,85,8,WS_EX_TRANSPARENT
    EDITTEXT        IDC_ebMeanSeaLevel,110,73,45,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ebWaterDepth,110,87,45,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ebOverburdenBottomTVD,109,116,45,12,ES_AUTOHSCROLL
    CONTROL         "List1",IDC_lstFormationDefinition,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,18,188,173,98
    PUSHBUTTON      "Add",IDC_btnAddFormation,18,293,50,14
    PUSHBUTTON      "Remove",IDC_btnRemoveFormation,141,292,50,14,WS_DISABLED
    GROUPBOX        "",IDC_fraOnshoreDefinition,7,27,195,28
    GROUPBOX        "",IDC_fraOffShoreDefinition,7,58,195,43
    LTEXT           "Substructure height",IDC_lbMeanGroundlevel,14,41,62,8
    LTEXT           "Air gap",IDC_lbMeanSeaLevel,14,74,60,10
    LTEXT           "Water depth",IDC_lbWaterDepth,14,87,60,10
    LTEXT           "Overburden bottom TVD",IDC_lbOverburdenBottomTVD,13,116,86,10
    LTEXT           "Model bottom TVD",IDC_lbModelBottomTVD,13,158,60,10
    EDITTEXT        IDC_ebModelBottomTVD,109,158,45,12,ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "[m]",IDC_lbUMeanGroundLevel,157,41,30,8
    LTEXT           "[m]",IDC_lbUMeanSeaLevel,157,73,30,8
    LTEXT           "[m]",IDC_lbUWaterDepth,157,87,30,8
    LTEXT           "[m]",IDC_lbUOverburdenBottomTVD,157,116,30,8
    LTEXT           "[m]",IDC_lbUModelBottomTVD,157,158,30,8
    GROUPBOX        "Formation definition",IDC_fraFormationDefinition,7,177,195,133
    GROUPBOX        "Model range",IDC_fraModelRange,7,105,195,68
    LTEXT           "Model top TVD",IDC_lbModelTopTVD,13,142,60,10
    EDITTEXT        IDC_ebModelTopTVD,109,143,45,12,ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "[m]",IDC_lbUModelTopTVD,157,143,30,8
    LTEXT           "Model range for analysis:",IDC_STATIC,13,130,91,10
    ICON            IDI_ICAppsStop,IDC_STATIC,7,7,20,20
    LTEXT           "The reference point for true vertical depths (TVD) is taken as Rig Kelly Bush (RKB)",IDC_STATIC,37,7,150,20
END

