    PUSHBUTTON      "To library",IDC_btnToLibrary,143,309,50,14
END

IDD_EditFormationMaterial DIALOGEX 0, 0, 214, 242
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Formation Material"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_ebName,105,20,73,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ebYoungsModulus,105,34,45,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ebPoissonRatio,105,47,45,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ebVolumetricSpecificHeat,105,60,45,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ebThermalConductivity,105,73,45,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ebThermalExpansion,105,86,45,12,ES_AUTOHSCROLL
    CONTROL         "Plasticity",IDC_chkPlasticity,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,21,127,40,10,WS_EX_TRANSPARENT
    EDITTEXT        IDC_ebCohesion,105,142,45,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ebFrictionAngle,105,156,45,12,ES_AUTOHSCROLL
    COMBOBOX        IDC_cmbHardeningType,105,170,75,59,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_ebHardeningGradient,105,184,45,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ebFractureEnergy,105,198,45,12,ES_AUTOHSCROLL
    PUSHBUTTON      "OK",IDOK,13,215,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,149,215,50,14
    GROUPBOX        "",IDC_fraEditFormationMaterial,7,7,200,229
    LTEXT           "Name",IDC_lbName,21,22,72,9
    LTEXT           "Young's modulus",IDC_lbYoungsModulus,21,34,83,10
    LTEXT           "Poisson ratio",IDC_lbPoissonRatio,21,46,83,10
    LTEXT           "[GPa]",IDC_lbUYoungsModulus,151,34,42,8
    LTEXT           "[-]",IDC_lbUPoissonRatio,151,47,42,8
    LTEXT           "Volumetric specific heat",IDC_lbVolumetricSpecificHeat,21,61,77,9
    LTEXT           "Thermal conductivity",IDC_ThermalConductivity,21,72,66,8
