GOCAD TSurf
HEADER {
name:back
}
TFACE
VRTX 0 0 100 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 3
TRGL 1 2 3
END


GOCAD TSurf
HEADER {
name:bottom
}
TFACE
VRTX 0 0 0 100
VRTX 1 100 0 100
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 2
TRGL 0 2 3
END
GOCAD TSurf
HEADER {
name:front42
}
TFACE
VRTX 0   0    0      0
VRTX 1 100    0      0
VRTX 2 100    0    100
VRTX 3   0    0    100
VRTX 4  25    0    50
VRTX 5  75    0    50
VRTX 6  50    0    50
TRGL 0 4 3
TRGL 0 4 6
TRGL 3 4 6
TRGL 3 6 2
TRGL 0 6 1
TRGL 1 5 6
TRGL 2 5 6
TRGL 2 5 1
END



GOCAD TSurf
HEADER {
name:left
}
TFACE
VRTX 0 0 0 0
VRTX 1 0 100 0
VRTX 2 0 100 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:right
}
TFACE
VRTX 0 100 0 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 100 0 100
TRGL 0 1 3
TRGL 1 2 3
END

GOCAD TSurf
HEADER {
name:top
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 100 0
VRTX 3 0 100 0
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:f_fault42
}
TFACE
VRTX 0  25    50   50
VRTX 1  75    50   50
VRTX 3  50    0    50
VRTX 4  25    0    50
VRTX 5  75    0    50
TRGL 0 1 3
TRGL 1 3 5
TRGL 0 3 4
END



GOCAD TSurf
HEADER {
name:b_fault42
}
TFACE
VRTX 0  25    50   50
VRTX 1  75    50   50
VRTX 3  50    0    50
VRTX 4  25    0    50
VRTX 5  75    0    50
TRGL 0 1 3
