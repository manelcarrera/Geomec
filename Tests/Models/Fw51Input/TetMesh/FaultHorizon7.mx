HEADER {
name:hori1
}
TFACE
VRTX 1 0   100   100
VRTX 2 100 100   100
VRTX 3 100   0   100
VRTX 4   0   0   100

VRTX 5  25  50   100
VRTX 6  30  75   125
VRTX 7  70  75   125
VRTX 8  75  50   100
VRTX 9  70  25    75
VRTX 10 30  25    75

TRGL 1 5 6
TRGL 1 2 6
TRGL 7 2 6
TRGL 7 2 8
TRGL 3 2 8
TRGL 3 9 8
TRGL 3 9 4
TRGL 10 9 4
TRGL 10 5 4
TRGL 1 5 4
END
