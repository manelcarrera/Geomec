# Cube split by a fault inside a superbox
GOCAD TSurf
HEADER {
name:outer_back
}
TFACE
VRTX 0 -2.000000 -2.000000 -2.000000 
VRTX 1 2.000000 -2.000000 -2.000000 
VRTX 2 2.000000 2.000000 -2.000000 
VRTX 3 -2.000000 2.000000 -2.000000 
VRTX 4 -2.000000 -2.000000 2.000000 
VRTX 5 2.000000 -2.000000 2.000000 
VRTX 6 2.000000 2.000000 2.000000 
VRTX 7 -2.000000 2.000000 2.000000 
TRGL 3 2 6
TRGL 3 6 7
END
