GOCAD TSurf
HEADER {
name:Back
}
TFACE
VRTX 0 100 100 0
VRTX 1 100 100 100
VRTX 2 100 0 100
VRTX 3 100 0 0
TRGL 0 1 2
TRGL 3 0 2
END
GOCAD TSurf
HEADER {
name:Top
}
TFACE
VRTX 4 0 0 0
VRTX 5 100 100 0
VRTX 6 100 0 0
VRTX 7 0 100 0
TRGL 4 5 6
TRGL 4 7 5
END
GOCAD TSurf
HEADER {
name:Bottom
}
TFACE
VRTX 9 0 0 100
VRTX 8 100 100 100
VRTX 10 100 0 100
VRTX 11 0 100 100
TRGL 9 8 10
TRGL 9 11 8
END
GOCAD TSurf
HEADER {
name:Right
}
TFACE
VRTX 12 0 100 0
VRTX 13 100 100 0
VRTX 14 0 100 100
VRTX 15 100 100 100
TRGL 12 13 14
TRGL 13 15 14
END
GOCAD TSurf
HEADER {
name:Left
}
TFACE
VRTX 16 0 0 0
VRTX 17 100 0 100
VRTX 18 0 0 100
VRTX 19 100 0 0
TRGL 16 17 18
TRGL 16 19 17
END
GOCAD TSurf
HEADER {
name:Front
}
TFACE
VRTX 20 0 0 0
VRTX 21 0 100 100
VRTX 22 0 0 100
VRTX 23 0 100 0
TRGL 20 21 22
TRGL 20 23 21
END
