# 2 nested normal cubes
GOCAD TSurf
HEADER {
name:inner_back
}
TFACE
VRTX 0 -1.000000 -1.000000 -1.000000 
VRTX 1 1.000000 -1.000000 -1.000000 
VRTX 2 1.000000 1.000000 -1.000000 
VRTX 3 -1.000000 1.000000 -1.000000 
VRTX 4 -1.000000 -1.000000 1.000000 
VRTX 5 1.000000 -1.000000 1.000000 
VRTX 6 1.000000 1.000000 1.000000 
VRTX 7 -1.000000 1.000000 1.000000 
TRGL 3 2 6
TRGL 3 6 7
END
GOCAD TSurf
HEADER {
name:inner_bottom
}
TFACE
