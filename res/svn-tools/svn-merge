#! /bin/sh

Usage()
{
  printf "Usage: %s [-v] -r<rev-number> <from-svn-url>\n" $(basename "$0")
  if [ -n "$1" ] ; then
    printf "  %s\n" "$1"
  fi
  exit 1
}

ParseLog()
{
  if [ $# -ne 1 ] ; then
    printf "Usage: ParseLog <logstring>\n"
    exit 1
  fi

  logtxt=$(printf "%s\n" "$1" | sed "/^-*$/d" | sed "/^$/d" | sed "/^r$revnum.*$/d")
