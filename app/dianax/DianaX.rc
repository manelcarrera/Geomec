IDD_DIANAX DIALOG DISCARDABLE  0, 0, 500, 303
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Calculating"
FONT 8, "MS Sans Serif"
BEGIN
