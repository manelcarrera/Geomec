# Single self-intersecting fault 
GOCAD TSurf
HEADER {
name:back
}
TFACE
VRTX 0 0 100 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 3
TRGL 1 2 3
END


GOCAD TSurf
HEADER {
name:bottom
}
TFACE
VRTX 0 0 0 100
VRTX 1 100 0 100
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 2
TRGL 0 2 3
END
GOCAD TSurf
HEADER {
name:front
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 0 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END



GOCAD TSurf
HEADER {
name:left
}
TFACE
VRTX 0 0 0 0
VRTX 1 0 100 0
VRTX 2 0 100 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:right
}
TFACE
VRTX 0 100 0 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 100 0 100
TRGL 0 1 3
TRGL 1 2 3
END

GOCAD TSurf
HEADER {
name:top
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 100 0
VRTX 3 0 100 0
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:f_Self
}
TFACE
VRTX 0 40.000000 40.000000 50.000000 
VRTX 1 40.000000 50.000000 50.000000 
VRTX 2 50.000000 40.000000 50.000000 
VRTX 3 50.000000 50.000000 50.000000 
VRTX 10 40.000000 50.000000 50.000000 
VRTX 11 40.000000 50.000000 40.000000 
VRTX 12 50.000000 50.000000 50.000000 
VRTX 13 50.000000 50.000000 40.000000 
VRTX 21 40.000000 30.000000 60.000000 
VRTX 23 50.000000 30.000000 60.000000 

TRGL 0 2 3
TRGL 0 1 3
TRGL 1 3 13
TRGL 1 11 13
TRGL 11 13 23
TRGL 11 21 23
END
GOCAD TSurf
HEADER {
name:b_Self
}
TFACE
VRTX 0 40.000000 40.000000 50.000000 
VRTX 1 40.000000 50.000000 50.000000 
VRTX 2 50.000000 40.000000 50.000000 
VRTX 3 50.000000 50.000000 50.000000 
VRTX 10 40.000000 50.000000 50.000000 
VRTX 11 40.000000 50.000000 40.000000 
VRTX 12 50.000000 50.000000 50.000000 
VRTX 13 50.000000 50.000000 40.000000 
VRTX 21 40.000000 30.000000 60.000000 
VRTX 23 50.000000 30.000000 60.000000 

TRGL 0 2 3
TRGL 0 1 3
TRGL 1 3 13
TRGL 1 11 13
TRGL 11 13 23
TRGL 11 21 23
END
