# Disconnected fault
GOCAD TSurf
HEADER {
name:back
}
TFACE
VRTX 0 0 100 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 3
TRGL 1 2 3
END


GOCAD TSurf
HEADER {
name:bottom
}
TFACE
VRTX 0 0 0 100
VRTX 1 100 0 100
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 2
TRGL 0 2 3
END
GOCAD TSurf
HEADER {
name:front
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 0 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END



GOCAD TSurf
HEADER {
name:left
}
TFACE
VRTX 0 0 0 0
VRTX 1 0 100 0
VRTX 2 0 100 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:right
}
TFACE
VRTX 0 100 0 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 100 0 100
TRGL 0 1 3
TRGL 1 2 3
END

GOCAD TSurf
HEADER {
name:top
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 100 0
VRTX 3 0 100 0
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:f_faultDouble
}
TFACE
VRTX 0 10 50 50
VRTX 1 20 50 50
VRTX 2 20 60 50
VRTX 3 10 60 50
VRTX 10 10 50 55
VRTX 11 20 50 55
VRTX 12 20 60 55
VRTX 13 10 60 55

TRGL 0 1 2
TRGL 0 2 3
TRGL 10 11 12
TRGL 10 12 13

END


GOCAD TSurf
HEADER {
name:b_faultDouble
}
TFACE
VRTX 0 10 50 50
VRTX 1 20 50 50
VRTX 2 20 60 50
VRTX 3 10 60 50
VRTX 10 10 50 55
VRTX 11 20 50 55
VRTX 12 20 60 55
VRTX 13 10 60 55

