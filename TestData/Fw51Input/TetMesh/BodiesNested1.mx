# Body nesting with free fault
GOCAD TSurf
HEADER {
name:back
}
TFACE
VRTX 0 0 100 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 3
TRGL 1 2 3
END


GOCAD TSurf
HEADER {
name:bottom
}
TFACE
VRTX 0 0 0 100
VRTX 1 100 0 100
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 2
TRGL 0 2 3
END
GOCAD TSurf
HEADER {
name:front
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 0 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END



GOCAD TSurf
HEADER {
name:left
}
TFACE
VRTX 0 0 0 0
VRTX 1 0 100 0
VRTX 2 0 100 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:right
}
TFACE
VRTX 0 100 0 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 100 0 100
TRGL 0 1 3
TRGL 1 2 3
END

GOCAD TSurf
HEADER {
name:top
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 100 0
VRTX 3 0 100 0
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:Back
}
TFACE
VRTX 0   1 99   1
VRTX 1 99 99   1
VRTX 2 99 99 99
VRTX 3   1 99 99
TRGL 0 1 3
TRGL 1 2 3
END


GOCAD TSurf
HEADER {
name:Bottom
}
TFACE
VRTX 0   1   1 99
VRTX 1 99   1 99
VRTX 2 99 99 99
VRTX 3   1 99 99
TRGL 0 1 2
TRGL 0 2 3
END
GOCAD TSurf
HEADER {
name:Front
}
TFACE
VRTX 0   1   1   1
VRTX 1 99   1   1
VRTX 2 99   1 99
VRTX 3   1   1 99
TRGL 0 1 2
TRGL 0 2 3
END



GOCAD TSurf
HEADER {
name:Left
}
TFACE
VRTX 0   1   1   1
VRTX 1   1 99   1
VRTX 2   1 99 99
VRTX 3   1   1 99
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:Right
}
TFACE
VRTX 0 99   1   1
VRTX 1 99 99   1
VRTX 2 99 99 99
VRTX 3 99   1 99
TRGL 0 1 3
TRGL 1 2 3
END

GOCAD TSurf
HEADER {
name:Top
}
TFACE
VRTX 0   1   1   1
VRTX 1 99   1   1
VRTX 2 99 99   1
VRTX 3   1 99   1
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:f_fault
}
TFACE
VRTX 0 10 50 50
VRTX 1 20 50 50
VRTX 2 20 60 50
VRTX 3 10 60 50
VRTX 4 15 55 50

TRGL 0 1 4
TRGL 1 4 2
TRGL 2 4 3
TRGL 0 4 3


END


GOCAD TSurf
HEADER {
name:b_fault
}
TFACE
VRTX 0 10 50 50
VRTX 1 20 50 50
VRTX 2 20 60 50
VRTX 3 10 60 50
VRTX 4 15 55 50

TRGL 0 1 4
TRGL 1 4 2
TRGL 2 4 3
TRGL 0 4 3


END


