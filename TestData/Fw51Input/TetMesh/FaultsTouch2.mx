# Extra fault points in 2 different faults with common edge 
GOCAD TSurf
HEADER {
name:back
}
TFACE
VRTX 0 0 100 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 3
TRGL 1 2 3
END


GOCAD TSurf
HEADER {
name:bottom
}
TFACE
VRTX 0 0 0 100
VRTX 1 100 0 100
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 2
TRGL 0 2 3
END
GOCAD TSurf
HEADER {
name:front
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 0 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END



GOCAD TSurf
HEADER {
name:left
}
TFACE
VRTX 0 0 0 0
VRTX 1 0 100 0
VRTX 2 0 100 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:right
}
TFACE
VRTX 0 100 0 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 100 0 100
TRGL 0 1 3
TRGL 1 2 3
END

GOCAD TSurf
HEADER {
name:top
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 100 0
VRTX 3 0 100 0
TRGL 0 1 2
TRGL 0 2 3
END


GOCAD TSurf
HEADER {
name:f_lfault
}
TFACE
VRTX 0 40 40 50
VRTX 1 40 60 50
VRTX 2 50 40 50
VRTX 3 50 60 50
VRTX 4 60 40 50
VRTX 5 60 60 50

TRGL 0 2 1
TRGL 1 2 3


END


GOCAD TSurf
HEADER {
name:b_lfault
}
TFACE
VRTX 0 40 40 50
VRTX 1 40 60 50
VRTX 2 50 40 50
VRTX 3 50 60 50
VRTX 4 60 40 50
VRTX 5 60 60 50

TRGL 0 2 1
TRGL 1 2 3


END


GOCAD TSurf
HEADER {
name:f_rfault
}
TFACE
VRTX 0 40 40 50
VRTX 1 40 60 50
VRTX 2 50 40 50
VRTX 3 50 60 50
VRTX 4 60 40 50
VRTX 5 60 60 50

TRGL 2 3 4
TRGL 3 4 5


END


GOCAD TSurf
HEADER {
name:b_rfault
}
TFACE
VRTX 0 40 40 50
VRTX 1 40 60 50
VRTX 2 50 40 50
VRTX 3 50 60 50
VRTX 4 60 40 50
VRTX 5 60 60 50

TRGL 2 3 4
TRGL 3 4 5


END


