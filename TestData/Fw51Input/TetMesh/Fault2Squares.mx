# Free fault of 2 squares inside box
GOCAD TSurf
HEADER {
name:back
}
TFACE
VRTX 0 0 100 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 3
TRGL 1 2 3
END


GOCAD TSurf
HEADER {
name:bottom
}
TFACE
VRTX 0 0 0 100
VRTX 1 100 0 100
VRTX 2 100 100 100
VRTX 3 0 100 100
TRGL 0 1 2
TRGL 0 2 3
END
GOCAD TSurf
HEADER {
name:front
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 100 0 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END



GOCAD TSurf
HEADER {
name:left
}
TFACE
