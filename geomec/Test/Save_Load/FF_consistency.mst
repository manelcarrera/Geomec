'$include '..\TestSuite.inc'

Viewport clear

StartLog("FF_consistency.new","FF_consistency")

Scenario ("FF Save consistency check")
StartScenario("FF Save consistency check")
	DIM bFileCreated as INTEGER
	bFileCreated = 0
	StartApp
	LoadModel(curdir$,"test2.gmp")
	Sleep(5)
	DumpModel("test2.txt")
	SaveModel(curdir$,"test.gmp")
	bFileCreated = 1
	ExitNoSave
	StartApp
	LoadModel(curdir$,"test.gmp")
	Sleep(5)
	DumpModel("test.txt")
	ExitNoSave
	if compare("test2.txt","test.txt") <> 0 then
		tnofail("The models are not equal.")
	endif
ScenarioPass
Scenario Cleanup
	if bFileCreated = 1 then
		Kill curdir$ + "/test.gmp"
	endif
End Scenario

EndLog
End
