GOCAD TSurf
HEADER {
name:Top
}
TFACE
VRTX 0 0 0 0
VRTX 1 0 200 0
VRTX 2 100 100 0
TRGL 0 1 2
END

GOCAD TSurf
HEADER {
name:Side_I
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END

GOCAD TSurf
HEADER {
name:Side_II
}
TFACE
VRTX 0 100 100 0
VRTX 1 0 200 0
VRTX 2 0 200 100
VRTX 3 100 100 100
TRGL 0 1 2
TRGL 0 2 3
END

GOCAD TSurf
HEADER {
name:Front
}
TFACE
VRTX 0 0 0 0
VRTX 1 0 200 0
VRTX 2 0 200 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END

GOCAD TSurf
HEADER {
name:Bottom
}
TFACE
VRTX 0 0 0 100
VRTX 1 0 200 100
VRTX 2 100 100 100
TRGL 0 1 2
END
