GOCAD TSurf
HEADER {
name:Top
}
TFACE
VRTX 0 0 0 0
VRTX 1 100 0 0
VRTX 2 200 0 0
VRTX 3 0 100 0
VRTX 4 100 100 0
VRTX 5 200 100 0
TRGL 0 1 4
TRGL 0 4 3
TRGL 1 2 5
TRGL 1 5 4
END

GOCAD TSurf
HEADER {
name:Front
}
TFACE
VRTX 0 0 0 100
VRTX 1 100 0 100
VRTX 2 200 0 100
VRTX 3 0 0 0
VRTX 4 100 0 0
VRTX 5 200 0 0
TRGL 0 1 4
TRGL 0 4 3
TRGL 1 2 5
TRGL 1 5 4
END

GOCAD TSurf
HEADER {
name:Back
}
TFACE
TFACE
VRTX 0 0 100 100
VRTX 1 100 100 100
VRTX 2 200 100 100
VRTX 3 0 100 0
VRTX 4 100 100 0
VRTX 5 200 100 0
TRGL 0 1 4
TRGL 0 4 3
TRGL 1 2 5
TRGL 1 5 4
END

GOCAD TSurf
HEADER {
name:Left
}
TFACE
VRTX 0 0 0 0
VRTX 1 0 100 0
VRTX 2 0 100 100
VRTX 3 0 0 100
TRGL 0 1 2
TRGL 0 2 3
END

GOCAD TSurf
HEADER {
name:Fault
}
TFACE
VRTX 0 100 0 0
VRTX 1 100 100 0
VRTX 2 100 100 100
VRTX 3 100 0 100
TRGL 0 1 3
TRGL 1 2 3
END

GOCAD TSurf
HEADER {
name:Right
}
TFACE
VRTX 0 200 0 0
VRTX 1 200 100 0
VRTX 2 200 100 100
VRTX 3 200 0 100
TRGL 0 1 3
TRGL 1 2 3
END


GOCAD TSurf
HEADER {
name:Bottom
}
TFACE
VRTX 0 0 0 100
VRTX 1 100 0 100
VRTX 2 200 0 100
VRTX 3 0 100 100
VRTX 4 100 100 100
VRTX 5 200 100 100
TRGL 0 1 4
TRGL 0 4 3
TRGL 1 2 5
TRGL 1 5 4
END
