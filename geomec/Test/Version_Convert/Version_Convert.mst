' *************************
' **** BEGIN TEST CASE ****
' *************************

'******* Test Case INITIALIZATION/SETUP *********
Viewport Clear

const SOURCE_DIR$		= "d:\users\all\source_models"
const TARGET_DIR$		= "d:\users\all\target_models"



'******* SCENARIO SECTION ***********************

'*** Scenario 1:
Scenario ("Conversion")



FILELIST CLEAR
FILELIST ADD SOURCE_DIR + "\*.gm3"
FOR TestFile$ IN FILELIST SORTED BY NAME
	StartApp
	ImportGM3Model(GetPathName(TestFile), GetFileName(TestFile))
	SaveModel(TARGET_DIR$, GetFileNameNoExt(TestFile))
	WMenuSelect("&Analysis\&Linear Depletion", 30)
	SLEEP(60)
	ExitNoSave
NEXT
	
		
Scenario Cleanup 'and handling of scenario failure

	
End Scenario



'******* Test Case CLEANUP **********************





' *************************
' ***** END TEST CASE *****
' *************************
End



