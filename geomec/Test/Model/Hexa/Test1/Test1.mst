' '$DEFINE and '$INCLUDE metacommands for test case
'-------------------------------------------------------------------
'$include 'Recorder.inc'
'$include 'AppSettings.inc'
'$include 'AppControl.inc'
'$include 'DataImport.inc'
'$include 'Formation.inc'
'$include 'Wellpath.inc'
'$include 'model.inc'
'$include 'material.inc'
'$include 'Boundary.inc'
'$include 'meshregion.inc'
'$include 'Timestep.inc'
'$include 'TreeControl.inc'
'$include 'Horizon.inc'


' DIM statements, TYPE declarations, global variables,
' constants, and so on for test case
'-------------------------------------------------------------------


' *************************
' **** BEGIN TEST CASE ****
' *************************

'******* Test Case INITIALIZATION/SETUP *********
Viewport Clear

StartLog("Shearwater_Build.new","Shearwater_Build")
'******* SCENARIO SECTION ***********************
 
'*** Scenario 1:
Scenario ("Test 1 Constant horizons with Z = 0")
' Start app and select a new horizon model
StartScenario("Test 1 Constant horizons with Z = 0")
	StartApp
	NewModel("Hexahedron")	
	' Increate to two depletion stages
	SetTimeStepCount(2)
	' Set global stress
	SetGlobalInitialStress(10, 10, 0, 1, 1)
	' Create constant depth horizons
	NewConstantDepthHorizon("Constant depth at 0 m", 0)		
	NewConstantDepthHorizon("Constant depth at 100 m", 100)	
	NewConstantDepthHorizon("Constant depth at 200 m", 200)
	' Set the boundary
	SetMainRegion(10, 10)
	SetUserDefinedBoundary(0, 0, 100, 100)
	' Define material
	NewMaterial("Material")
	AssignMaterial("Material", "Constant depth at 0 m")
	AssignMaterial("Material", "Constant depth at 100 m")
	' Define the pressures
	SetPressureConstant("Constant depth at 100 m", "Initial", 20, 0, 0)
	SetPressureConstant("Constant depth at 100 m", "Depletion stage 1", 10, 0, 0)
'	LinCalc
	DumpModel(CURDIR$ + "\dump.txt")	
ScenarioPass		
Scenario Cleanup 'and handling of scenario failure
ExitNoSave
End Scenario

EndLog


'******* Test Case CLEANUP **********************





' *************************
' ***** END TEST CASE *****
' *************************
End



