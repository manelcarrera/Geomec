'*****************************************************************************
'                          LOCAL SCRIPT SUBS/FUNCTIONS
'*****************************************************************************
SUB Gm3Test(sDirectory As STRING)

FILELIST CLEAR
FILELIST ADD sDirectory + "\*.gm3"
FOR TestFile$ IN FILELIST SORTED BY NAME
	ImportGM3Model(GetPathName(TestFile), GetFileName(TestFile))
	'Compare the files
	IF RESULT_RECORD THEN
		DumpModel(sDirectory + "\" + GetFileNameNoExt(TestFile) + ".res")
	ELSE
		DumpModel(sDirectory + "\" + GetFileNameNoExt(TestFile) + ".new")
		IF COMPARE (sDirectory + "\" + GetFileNameNoExt(TestFile) + ".new", sDirectory + "\" + GetFileNameNoExt(TestFile) + ".res" ) = 0 THEN
			'Test ok
		ELSE
			Fail("Contents of " + GetFileNameNoExt(TestFile) + " not OK")
		END IF
	END IF

NEXT

END SUB
