'******* Test Case INITIALIZATION/SETUP *********
Viewport Clear




'******* SCENARIO SECTION ***********************

'*** Scenario 1:
Scenario ("Tutor_Build")
StartApp
NewModel("Horizon")
' Read horizons
FILELIST CLEAR
FILELIST ADD CurDir$ + "\Horizons\*.txt"
FOR TestFile$ IN FILELIST SORTED BY NAME
	Import(GetPathName(TestFile), GetFileName(TestFile))
	CreateHorizonFromSurface(GetFileName(TestFile))
NEXT
	
' Read Pressures
FILELIST CLEAR
FILELIST ADD CurDir$ + "\Pressure\*.txt"
FOR TestFile$ IN FILELIST SORTED BY NAME
	Import(GetPathName(TestFile), GetFileName(TestFile))
NEXT

Dim names As VARIANT
names = Formations()
for x = LBOUND(names) to UBOUND(names)
	print names(x)
next x
