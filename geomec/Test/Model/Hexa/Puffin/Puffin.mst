'******* Test Case INITIALIZATION/SETUP *********
Viewport Clear




'******* SCENARIO SECTION ***********************

'*** Scenario 1:
Scenario ("Puffin Builder")
StartApp
NewModel("Horizon")
FILELIST CLEAR
FILELIST ADD CurDir$ + "\Horizon_Files\*.DAT"
FOR TestFile$ IN FILELIST SORTED BY NAME
	Import(GetPathName(TestFile), GetFileName(TestFile))
	AttriPointSet(GetFileNameNoExt(TestFile), 2)
	NewProperty("Surface")
	Sleep(1)
	WTreeItemDblClk("@1", "Surface")
	Sleep(1)
	WViewItemClk("@1", "Property 0", VK_LBUTTON)
	Sleep(1)
	WTreeItemDragTo("@1", "Surface\Value", VK_LBUTTON)
	WButtonClick("OK")
NEXT





	
		
Scenario Cleanup 'and handling of scenario failure
ExitNoSave
	
End Scenario



'******* Test Case CLEANUP **********************





' *************************
' ***** END TEST CASE *****
' *************************
End



