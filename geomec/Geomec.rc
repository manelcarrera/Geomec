IDD_DOUBLE_PROGRESS DIALOG 0, 0, 367, 97
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,159,75,50,14
    LTEXT           "** Primiry Comment Bar  ***",IDC_ST_PRIMARY,10,5,350,10
    CONTROL         "Progress1",IDC_PB_PRIMARY,"msctls_progress32",PBS_SMOOTH | WS_BORDER,10,20,350,10
    LTEXT           "** Secudary Comment Bar  ***",IDC_ST_SECUNDARY,10,40,350,10
    CONTROL         "Progress1",IDC_PB_SECUNDARY,"msctls_progress32",PBS_SMOOTH | WS_BORDER,10,55,350,10
END

IDD_SINGLE_PROGRESS DIALOG 0, 0, 372, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,155,41,50,14
    LTEXT           "** Primiry Comment Bar  ***",IDC_ST_PRIMARY,10,5,350,10
    CONTROL         "Progress1",IDC_PB_PRIMARY,"msctls_progress32",PBS_SMOOTH | WS_BORDER,10,20,350,10
END

IDD_NEW_MODEL_DLG DIALOG 0, 0, 177, 101
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New model"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,120,5,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,120,22,50,14
    CONTROL         "List1",IDC_LB_MODEL,"SysListView32",LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_AUTOARRANGE | WS_BORDER | WS_TABSTOP,5,5,105,90
END

IDD_ATRI_SURFACE DIALOGEX 0, 0, 262, 116
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Surface attributes"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,205,5,50,14
    LTEXT           "Number of triangles:",IDC_STATIC,20,57,70,12
    LTEXT           "**NR OF TRI**",IDC_ST_NR_OF_TRI,100,57,85,10
    LTEXT           "Status:",IDC_STATIC,20,72,30,12
    LTEXT           "**STATUS SURFACE**",IDC_ST_STATUS,100,72,85,8
    LTEXT           "Name:",IDC_STATIC,20,20,25,15
    EDITTEXT        IDC_ED_NAME,55,20,130,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Cancel",IDCANCEL,205,21,50,14
    GROUPBOX        "General",IDC_STATIC,10,5,185,104
    LTEXT           "Colour:",IDC_STATIC,20,40,25,8
    CONTROL         "",IDC_ST_COLOR,"Static",SS_BLACKFRAME | SS_NOTIFY,55,40,10,10
    LTEXT           "Unit:",IDC_STATIC,20,87,30,12,NOT WS_VISIBLE
