    LTEXT           "Project description",IDC_STATIC,10,5,75,10
    LTEXT           "File Version",IDC_STATIC,10,140,50,10
    LTEXT           "**FILE VERSION**",IDC_ST_FILE_VERSION,77,140,148,10
    LTEXT           "Application Version",IDC_STATIC,10,155,61,10
