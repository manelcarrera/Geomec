    LTEXT           "Note: Friction angle and cohesion will only be used for post- processing purposes.",IDC_STATIC,26,63,208,18
    LTEXT           "Note: Friction angle and cohesion will only be used for post- processing purposes.",IDC_STATIC,26,116,208,18
    LTEXT           "Note: Fault in Full Stick in linear analysis",IDC_STATIC,26,94,145,9
    LTEXT           "&Fault/&Fracture:",IDC_STATIC,13,12,50,8
    GROUPBOX        "Initialization D0 Fault Parameters",IDC_STATIC,7,161,271,56
    LTEXT           "Cohesion",IDC_LBL_COHESION,26,173,38,10
    LTEXT           "UNIT",IDC_UN_COHESION,156,173,45,10
    LTEXT           "Friction angle",IDC_LBL_FRICTION,26,187,46,10
    LTEXT           "UNIT",IDC_UN_FRICTION,156,187,45,10
