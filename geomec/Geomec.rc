IDD_GLOBAL_FAULT_BEHAVIOUR DIALOGEX 0, 0, 299, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fluid Pressure Assumption"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,187,169,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,242,169,50,14
    GROUPBOX        "",IDC_STATIC,6,3,286,160,WS_GROUP
    CONTROL         "Take the maximum pressure from formation elements at either side of the fault",IDC_RADIO_MAXIMUM,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP,25,21,261,10
    CONTROL         "Take the minimum pressure from formation elements at either side of the fault",IDC_RADIO_MINIMUM,
                    "Button",BS_AUTORADIOBUTTON,25,37,259,10
    CONTROL         "Specify the fluid pressure gradient",IDC_RADIO_GRADIENT,
                    "Button",BS_AUTORADIOBUTTON,25,53,122,10,WS_EX_TRANSPARENT
    CONTROL         "Take the maximum formation pressure around the fault, compensated for fluid density gradient. The lowest fluid density from all connected Formation material parameters is being used.",IDC_RADIO_MAXGRADIENT,
                    "Button",BS_AUTORADIOBUTTON | BS_TOP | BS_MULTILINE,25,131,259,28
    GROUPBOX        "",IDC_STATIC,14,53,270,73,WS_GROUP
    LTEXT           "Reference depth",IDC_LBL_DEPTH,25,72,54,8
    EDITTEXT        IDC_ED_DEPTH,105,69,74,14,ES_AUTOHSCROLL
    LTEXT           "**UNIT**",IDC_UN_DEPTH,188,72,29,8
    LTEXT           "Reference pressure",IDC_LBL_PRESSURE,25,90,63,8
    EDITTEXT        IDC_ED_PRESSURE,105,86,74,14,ES_AUTOHSCROLL
    LTEXT           "**UNIT**",IDC_UN_PRESSURE,188,89,29,8
    LTEXT           "Gradient",IDC_LBL_GRADIENT,25,107,28,8
    EDITTEXT        IDC_ED_GRADIENT,105,104,74,14,ES_AUTOHSCROLL
    LTEXT           "**UNIT**",IDC_UN_GRADIENT,188,107,29,8
END

IDD_CONVERGENCE_OPTIONS DIALOGEX 0, 0, 391, 191
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced convergence options"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,334,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,334,25,50,14
    GROUPBOX        "",IDC_STATIC,7,7,319,177
    CONTROL         "Disable non-linearity in individual elements",IDC_CHECK_CONVERGENCE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,7,150,10
    GROUPBOX        "",IDC_STATIC,14,26,304,37
    CONTROL         "Disable non-linearity when the minimum angle between edges is less than",IDC_CHECK_ANGLE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,26,249,10
    EDITTEXT        IDC_EDIT_ANGLE,22,40,40,14,ES_AUTOHSCROLL
    LTEXT           "degrees",IDC_UNIT_ANGLE,66,42,27,8
    GROUPBOX        "",IDC_STATIC,14,76,304,37
    CONTROL         "Disable non-linearity when the minimum ratio of shortest and longest edge is less than",IDC_CHECK_RATIO,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,76,290,10
    EDITTEXT        IDC_EDIT_RATIO,22,91,40,14,ES_AUTOHSCROLL
    GROUPBOX        "",IDC_STATIC,14,126,304,48
    CONTROL         "Disable non-linearity when the volume is less than",IDC_CHECK_VOLUME,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,126,175,10
    EDITTEXT        IDC_EDIT_VOLUME,22,141,40,14,ES_AUTOHSCROLL
    LTEXT           "Static",IDC_UNIT_VOLUME,66,143,27,8
    LTEXT           "Note: this test is not performed in wellpath zoomin and well casing models",IDC_LBL_NOTE,22,159,236,8
END

