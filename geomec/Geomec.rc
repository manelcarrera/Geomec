IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Model\tCtrl+N",          ID_FILE_NEW
        MENUITEM "&Open Model...\tCtrl+O",      ID_FILE_OPEN
        MENUITEM "&Save Model\tCtrl+S",         ID_FILE_SAVE
        MENUITEM "Save Model &As...",           ID_FILE_SAVE_AS
        MENUITEM "Save Model &With Averaged Results Only", ID_FILE_SAVEMODELWITHAVERAGEDRESULTSONLY
        MENUITEM "&Close Model\tCtrl+F4",       ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Save &Graphics Screen ...",   ID_FILE_SAVE_GRAPHICS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "&Model Attributes",           ID_FILE_MODEL_PROPERTIES
        MENUITEM "Model S&ummary",              ID_FILE_MODELSUMMARY
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        POPUP "&Toolbar"
        BEGIN
            MENUITEM "&General",                    ID_VIEW_TOOLBAR_GENERAL
            MENUITEM "&View",                       ID_VIEW_TOOLBAR_VIEW
            MENUITEM "Analysis",                    ID_VIEW_TOOLBAR_CALC
            MENUITEM "&Mesh Selecter",              ID_VIEW_MESH_DLGBAR
            MENUITEM "Vector &display",             ID_VIEW_TOOLBAR_VECTORDISPLAY
            MENUITEM "Tensor",                      ID_TOOLBAR_TENSOR
        END
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Perspective",                ID_VIEW_PERSPECTIVE
        MENUITEM "&Fill",                       ID_VIEW_FILL
        MENUITEM "&Rotate",                     ID_VIEW_ROTATE
        MENUITEM "&Boundary",                   ID_VIEW_BOUNDARY
        MENUITEM "&Axis",                       ID_VIEW_AXIS
        MENUITEM SEPARATOR
        MENUITEM "&Geology",                    ID_VIEW_COLOR
        MENUITEM "&Value",                      ID_VIEW_VALUE
        MENUITEM SEPARATOR
        MENUITEM "&Global colorscale",          ID_VIEW_GLOBAL
        MENUITEM "&Local colorscale",           ID_VIEW_LOCAL
        MENUITEM "&Hotspot",                    ID_VIEW_HOTSPOT
        MENUITEM "&Color Scale ...",            ID_VIEW_COLORSCALE
        MENUITEM SEPARATOR
        MENUITEM "Copy p&icture",               ID_COPYPICTURE
        MENUITEM SEPARATOR
        MENUITEM "Automatically Disable Redrawing", ID_VIEW_AUTOMATICALLYDISABLEREDRAWING
        MENUITEM "Refresh View\tCtrl+R",        ID_VIEW_REFRESHVIEW
        MENUITEM SEPARATOR
        MENUITEM "&Options ....",               ID_VIEW_OPTIONS
    END
    POPUP "&Analysis"
    BEGIN
        MENUITEM "&Calculation criteria",       ID_INPUT_STATUS
        MENUITEM SEPARATOR
        MENUITEM "&Linear Depletion",           ID_ANALYSIS_LINEAR_DEPLETION
        MENUITEM "&Nonlinear Depletion",        ID_ANALYSIS_NONLINEAR_CALCULATION
        MENUITEM "&Heat Flow",                  ID_ANALYSIS_HEAT_FLOW
        MENUITEM "&Mixture",                    ID_ANALYSIS_MIXTURE
        MENUITEM "Mixture &with containment",   ID_ANALYSIS_MIXTURE_CONTAINMENT
        MENUITEM SEPARATOR
        MENUITEM "&GVT Analysis",               ID_START_GVT
        MENUITEM "&QuickBlocks Analysis",       ID_ANALYSIS_QUICKBLOCKS
        MENUITEM SEPARATOR
        MENUITEM "Clear Analysis &History",     ID_ANALYSIS_CLEARHISTORY
        MENUITEM "&Analysis Log",               ID_ANALYSISLOG
        POPUP "Invalidate Results"
        BEGIN
            MENUITEM "All",                         ID_INVALIDATERESULTS_ALL
            MENUITEM SEPARATOR
            MENUITEM "Linear Depletion",            ID_INVALIDATERESULTS_LINEAR
            MENUITEM "Nonlinear Depletion",         ID_INVALIDATERESULTS_NONLINEAR
            MENUITEM "Heat Flow",                   ID_INVALIDATERESULTS_HEATFLOW
            MENUITEM "Mixture",                     ID_INVALIDATERESULTS_MIXTURE
            MENUITEM "Mixture with containment",    ID_INVALIDATERESULTS_MIXTURE_CONTAINMENT
        END
    END
    POPUP "&Import"
    BEGIN
        MENUITEM "Import &Mesh",                ID_IMPORT_IMPORTMESH
        MENUITEM "Import &Results",             ID_IMPORT_IMPORTRESULTS
        MENUITEM "Import &Surfaces",            ID_IMPORT_IMPORTSURFACES
        MENUITEM "Import &Point/Element sets",  ID_IMPORT_IMPORTPOINTELEMENTSETS
        MENUITEM "Insert Deviated &Wellpath",   ID_IMPORT_INSERTDEVIATEDWELLPATH
    END
    POPUP "&Export"
    BEGIN
        MENUITEM "Export &Linear Depletion Input Files", ID_EXPORT_LINEAR
        MENUITEM "Export &Nonlinear Depletion Input Files", ID_EXPORT_NONLIN
        MENUITEM "Export &Heat Flow Input Files", ID_EXPORT_HEAT_FLOW
        MENUITEM "Export &Mixture Input Files", ID_EXPORT_MIXTURE
        MENUITEM "Export Mixture &with containment Input Files", ID_EXPORT_MIXTURE_CONTAINMENT
        MENUITEM SEPARATOR
        MENUITEM "Export command files with &defaults", ID_EXPORTCOMMANDFILESWITHDEFAULTS
        MENUITEM SEPARATOR
        MENUITEM "Export line graph data",      ID_EXPORT_LINE_DATA
        MENUITEM SEPARATOR
        MENUITEM "Export &Results",             ID_EXPORT_RESULTS
        MENUITEM "Export Results to &GoCad",    ID_EXPORT_RESULTS_GOCAD
        MENUITEM "Export Results to &SVS",      ID_EXPORT_SVS
        MENUITEM SEPARATOR
        MENUITEM "Export S&urfaces",            ID_EXPORT_SURFACES
        MENUITEM SEPARATOR
        MENUITEM "Export &quadratic order data file for DIANA analysis", ID_EXPORT_QUAD_DAT
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&Initial Stress Procedure Settings", ID_ANALYSIS_LINEAR_SETTINGS
        MENUITEM "&Nonlinear Calculation Parameters", ID_ANALYSIS_NONLINEAR_CALC_PARAMS
        MENUITEM "&Fault && Fracture Settings", ID_SETTINGS_FAULTINITIALIZATIONSETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&GVT Settings",               ID_SETTINGS_GVTSETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&Borrow license",             ID_SETTINGS_BORROWLICENSE
        MENUITEM SEPARATOR
        MENUITEM "&Options",                    ID_ANALYSIS_PROPERTIES
        MENUITEM "Optimi&zation && Experimental Settings", ID_SETTINGS_OPTIMIZATIONSETTINGS
    END
    POPUP "Plugins"
    BEGIN
        MENUITEM "Add",                         ID_PLUGINS_ADD
        POPUP "Remove"
        BEGIN
            MENUITEM "HOLA",                        ID_REMOVE_HOLA
        END
        MENUITEM SEPARATOR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help Topics",                ID_HELP_FINDER
        MENUITEM "Visualization &Tutorial",     ID_OIV_TUTORIAL
        MENUITEM "&License borrowing",          ID_LICENSE_HELP
        MENUITEM "&Well Zoom-in",               ID_WELL_ZOOMIN_HELP
        MENUITEM "&GVT Quick Tour",             ID_GVT_QUICK_TOUR_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About Geomec...",            ID_APP_ABOUT
    END
END


