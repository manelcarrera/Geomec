    COMBOBOX        1137,36,3,138,300,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",1088,172,2,102,17,NOT WS_VISIBLE | NOT WS_GROUP
    LISTBOX         1120,4,20,272,85,LBS_SORT | LBS_NOINTEGRALHEIGHT | LBS_MULTICOLUMN | NOT WS_VISIBLE | WS_HSCROLL
