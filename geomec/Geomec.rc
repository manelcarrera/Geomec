END

IDD_ATTRI_MODEL_GENERAL DIALOGEX 0, 0, 237, 173
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "File name",IDC_STATIC,10,95,45,8
    LTEXT           "**FILE NAME**",IDC_ST_FILE_NAME,77,95,148,10
    LTEXT           "File location",IDC_STATIC,10,110,45,8
