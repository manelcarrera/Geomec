    POPUP "POPUP_DEPLETION"
    BEGIN
        MENUITEM "Insert Before",               ID_POPUP_INSERTBEFORE
        MENUITEM "Insert After",                ID_POPUP_INSERTAFTER
        MENUITEM "Delete",                      ID_POPUP_DELETE
    END
END


