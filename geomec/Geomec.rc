IDD_INITIAL_TEMPERATURE DIALOGEX 0, 0, 228, 116
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Global Temperature"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,114,95,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,171,95,50,14
    CONTROL         "Use extrapolated points for the entire model",IDC_RD_EXTRA_POLATE,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP,14,7,152,10
    CONTROL         "Use the following temperature outside the range of pointsets",IDC_RD_PRE_DEFINED,
                    "Button",BS_AUTORADIOBUTTON,14,22,201,10,WS_EX_TRANSPARENT
    GROUPBOX        "",IDC_STATIC,7,22,214,65,WS_GROUP
    LTEXT           "Reference Temperature",IDC_LBL_CONSTANT_PRESSURE,15,38,76,10
    EDITTEXT        IDC_ED_CONSTANT_VALUE,98,36,75,12,ES_AUTOHSCROLL
    LTEXT           "UNIT",IDC_LOAD_UNIT,182,38,27,8,NOT WS_GROUP
    LTEXT           "Reference Depth",IDC_LBL_CONSTANT_DEPTH,15,53,69,10
    EDITTEXT        IDC_ED_CONSTANT_DEPTH,98,51,75,12,ES_AUTOHSCROLL
    LTEXT           "UNIT",IDC_ST_DEPTH_UNIT,182,53,27,8,NOT WS_GROUP
    LTEXT           "Gradient",IDC_LBL_CONSTANT_GRADIENT,15,68,63,10
    EDITTEXT        IDC_ED_CONSTANT_GRADIENT,98,66,75,12,ES_AUTOHSCROLL
    LTEXT           "UNIT",IDC_ST_GRADIENT_UNIT,182,68,27,8,NOT WS_GROUP
END

