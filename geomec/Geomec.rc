IDD_ATTRI_MODEL_TIMESTEP DIALOGEX 0, 0, 237, 185
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Depletion Stages"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "Number of depletion stages:",IDC_STATIC,10,11,95,8
    EDITTEXT        IDC_ED_TIMESTEPS,116,10,65,12,ES_AUTOHSCROLL
    CONTROL         "List3",IDC_LB_TIMESTEP,"SysListView32",LVS_REPORT | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,10,30,205,100
    CONTROL         "Cleanup old results on calculation database",IDC_CHK_CLNRES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,137,157,10
    LTEXT           "(reduces file size, but takes computation time, only available for models with branches and/or phases)",IDC_TXT_CLNRES,22,150,194,20
END

