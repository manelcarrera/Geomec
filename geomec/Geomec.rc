    LTEXT           "Files of &type:",1089,5,131,48,8,SS_NOTIFY
    COMBOBOX        1136,54,129,155,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Open as &read-only",1040,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,54,148,74,10
    DEFPUSHBUTTON   "&Export",IDOK,222,110,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,222,128,50,14
    PUSHBUTTON      "&Help",1038,222,145,50,14
END

IDD_ABOUTBOX DIALOGEX 0, 0, 262, 63
