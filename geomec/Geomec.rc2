//
// Version
//
#include "../version/h/version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION GM_MAJOR, GM_MINOR, GM_BUILD, GM_REVISION
 PRODUCTVERSION GM_MAJOR, GM_MINOR, GM_BUILD, GM_REVISION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", ""
            VALUE "CompanyName", "Shell International"
            VALUE "FileDescription", "Geomec MFC Application"
            VALUE "FileVersion", xstr(GM_MAJOR) "." xstr(GM_MINOR) "." xstr(GM_BUILD) "." xstr(GM_REVISION)
            VALUE "InternalName", "Geomec"
            VALUE "LegalCopyright", "Copyright (C) 2000 - 2019"
            VALUE "OriginalFilename", "Geomec.EXE"
            VALUE "ProductName", "Geomec Application"
            VALUE "ProductVersion", xstr(GM_MAJOR) "." xstr(GM_MINOR) "." xstr(GM_BUILD) "." xstr(GM_REVISION) " " GM_BUILD_PREFIX " " xstr(GM_BUILD_STRING)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


