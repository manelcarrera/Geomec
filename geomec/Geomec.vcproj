				Name="VCLinkerTool"
				AdditionalDependencies="QtCore4.lib QtGui4.lib QtXml4.lib QtOpenGL4.lib $(LIBLBFL) $(LIBLBCP) $(LIBLBDC) opengl32.lib glu32.lib $(LIBLBCX) $(LIBLBDS) HtmlHelp.lib kernel32.lib user32.lib gdi32.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib imm32.lib wsock32.lib winspool.lib winmm.lib $(LIBLBCI) psapi.lib $(LIBLBEL) $(LIBLBGS) License.lib LicenseResource.lib qwt.lib ../UserDLLs/x64/RGINterface.LIB $(LIBLBGCCLASSES) $(LIBLBGCROUTINES)"
				OutputFile="$(OutDir)/Geomec.exe"
				LinkIncremental="2"
				SuppressStartupBanner="true"
				AdditionalLibraryDirectories="&quot;$(DIAOBJ)&quot;;&quot;$(DIAOBJ)/ci&quot;;&quot;$(DIAOBJ)/lib&quot;;&quot;$(DSPLIB)&quot;;&quot;$(QTDIR)/lib&quot;;FlexLM/lib64;&quot;$(QWTDIR)/lib&quot;"
				IgnoreDefaultLibraryNames="libcmt.lib"
				ProgramDatabaseFile="$(IntDir)/Geomec.pdb"
				GenerateMapFile="true"
				MapFileName="$(IntDir)/Geomec.map"
				SubSystem="2"
				RandomizedBaseAddress="1"
				DataExecutionPrevention="0"
				TargetMachine="17"
			/>
			<Tool
				Name="VCALinkTool"
			/>
			<Tool
				Name="VCManifestTool"
			/>
			<Tool
