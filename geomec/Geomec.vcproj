		<Filter
			Name="Help Files"
			Filter="cnt;rtf"
			>
			<File
				RelativePath="Help\geomec.hhp"
				>
				<FileConfiguration
					Name="Debug|Win32"
					>
					<Tool
						Name="VCCustomBuildTool"
						Description="Making HTML help file..."
						CommandLine="&quot;C:\Program Files\HTML Help Workshop\hhc.exe&quot; Help\$(InputName).hhp&#x0D;&#x0A;echo.&#x0D;&#x0A;copy Help\$(InputName).chm $(OutDir)\$(InputName).chm&#x0D;&#x0A;copy Help\$(InputName).chm $(IntDir)\$(InputName).chm&#x0D;&#x0A;"
						AdditionalDependencies="Help\geomec.hm;..\lib\matlib\hlp\matlib.hm"
						Outputs="$(OutDir)\$(InputName).chm"
					/>
				</FileConfiguration>
				<FileConfiguration
					Name="Debug|x64"
					>
					<Tool
						Name="VCCustomBuildTool"
						Description="Making HTML help file..."
						CommandLine="&quot;C:\Program Files (x86)\HTML Help Workshop\hhc.exe&quot; Help\$(InputName).hhp&#x0D;&#x0A;echo.&#x0D;&#x0A;copy Help\$(InputName).chm $(OutDir)\$(InputName).chm&#x0D;&#x0A;copy Help\$(InputName).chm $(IntDir)\$(InputName).chm&#x0D;&#x0A;"
						AdditionalDependencies="Help\geomec.hm"
						Outputs="$(OutDir)\$(InputName).chm"
					/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32"
					>
					<Tool
						Name="VCCustomBuildTool"
						Description="Making HTML help file..."
						CommandLine="&quot;C:\Program Files\HTML Help Workshop\hhc.exe&quot; Help\$(InputName).hhp&#x0D;&#x0A;echo.&#x0D;&#x0A;copy Help\$(InputName).chm $(OutDir)\$(InputName).chm&#x0D;&#x0A;copy Help\$(InputName).chm $(IntDir)\$(InputName).chm&#x0D;&#x0A;"
						AdditionalDependencies="Help\geomec.hm;..\lib\matlib\hlp\matlib.hm"
						Outputs="$(OutDir)\$(InputName).chm"
					/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|x64"
					>
					<Tool
						Name="VCCustomBuildTool"
						Description="Making HTML help file..."
