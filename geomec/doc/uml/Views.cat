		    stereotype 	"virtual"
		    parameters 	(list Parameters
			(object Parameter "nIDMoveCommand"
			    quid       	"3A07D0C00392"
			    type       	"UINT"))
		    result     	"BOOL"
		    concurrency 	"Sequential"
