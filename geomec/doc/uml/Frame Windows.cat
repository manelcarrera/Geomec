		(object Inheritance_Relationship
		    quid       	"3A07D0B70096"
		    supplier   	"Logical View::MFC 6.0::CObject Classes::Application Architecture::Window Support::Frame Windows::CFrameWnd"
		    quidu      	"3A07D0B6024E"))
