	(object Class "CGeoGraphItem"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"VC++"
		    name       	"AppliedPattern"
		    value      	"none")
		(object Attribute
		    tool       	"VC++"
		    name       	"AfxSupportMacro"
		    value      	"")
		(object Attribute
		    tool       	"VC++"
		    name       	"AfxBaseClass"
