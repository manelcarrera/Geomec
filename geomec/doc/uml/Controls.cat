		    name       	"AfxClassType"
		    value      	"CWnd"))
	    quid       	"3A07D0C40211"
	    documentation 	"The CScrollBar class provides the functionality of a Windows scroll-bar control. "
	    superclasses 	(list inheritance_relationship_list
		(object Inheritance_Relationship
		    quid       	"3A07D0C4024D"
