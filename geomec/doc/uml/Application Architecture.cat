		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Dump"
		    quid       	"3A07D0B502CE"
		    stereotype 	"virtual, const"
		    parameters 	(list Parameters
			(object Parameter "dc"
			    quid       	"3A07D0B502CF"
