		    stereotype 	"virtual"
		    parameters 	(list Parameters
			(object Parameter "dwCloseOption"
			    quid       	"3A07D0B50328"
			    type       	"OLECLOSE"
			    initv      	"OLECLOSE_NOSAVE"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
