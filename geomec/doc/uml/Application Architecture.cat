	(object Class "COleDocument"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"VC++"
		    name       	"Generate"
		    value      	FALSE)
		(object Attribute
		    tool       	"VC++"
		    name       	"HeaderFile"
		    value      	"<afxole.h>")
