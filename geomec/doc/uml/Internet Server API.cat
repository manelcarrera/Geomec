| 
|return %1::%2(pCtxt, pszQuery, pszCommand);
|
			    )))
		    quid       	"3A07D0C6023D"
		    stereotype 	"virtual"
		    parameters 	(list Parameters
			(object Parameter "pCtxt"
			    quid       	"3A07D0C60246"
			    type       	"CHttpServerContext*")
			(object Parameter "pszQuery"
			    quid       	"3A07D0C60250"
			    type       	"LPTSTR")
			(object Parameter "pszCommand"
			    quid       	"3A07D0C60251"
			    type       	"LPTSTR"))
		    result     	"int"
