			(object Parameter "dwNotificationType"
			    quid       	"3A07D0C600CA"
			    type       	"DWORD")
			(object Parameter "pvNotification"
			    quid       	"3A07D0C600D3"
			    type       	"LPVOID"))
		    result     	"DWORD"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
