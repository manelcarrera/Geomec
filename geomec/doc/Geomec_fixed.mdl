			    (object Class "CSplash"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"VC++"
					name       	"AppliedPattern"
					value      	"none")
				    (object Attribute
					tool       	"VC++"
					name       	"AfxSupportMacro"
					value      	"Dynamic"))
				quid       	"3C74E3E602BF"
				documentation 	
|////////////////////////////////////////////////////////////////
| Splash screen. To use it, write:
|
| CSplash *pSplash = new CSplash(
|    IDB_MYBITMAP,        // resource ID of bitmap
|    duration,            // min time to display, in msec
|    flags,               // see below
|    &pSplash);           // address of back pointer
|
| If you want to kill the screen, you can call
|
| if (pSplash)
|    pSplash->Kill();
|
| but this is usually unnecessary. You don't have to call delete either;
| CSplash will delete itself. When it does, it sets your pointer to NULL so
| you won't try to call Kill on a bad pointer.
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3C74E3E602EE"
					supplier   	"CWinThread"))
				operations 	(list Operations
				    (object Operation "CSplash"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"VC++"
						name       	"Inline"
						value      	FALSE))
					quid       	"3C74E3E602EF"
					parameters 	(list Parameters
					    (object Parameter "nIDRes"
						quid       	"3C74E3E602F0"
						type       	"UINT")
					    (object Parameter "duration"
						quid       	"3C74E3E602F1"
						type       	"UINT")
					    (object Parameter "flags"
						quid       	"3C74E3E602F2"
						type       	"WORD"
						initv      	"0")
					    (object Parameter "ppBackPtr"
						quid       	"3C74E3E602F3"
						type       	"CSplash* *"
						initv      	"NULL"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "~CSplash"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"VC++"
						name       	"Inline"
						value      	FALSE))
					quid       	"3C74E3E602FE"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "OnCreateSplashWnd"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"VC++"
						name       	"Inline"
						value      	FALSE))
					quid       	"3C74E3E602FF"
					documentation 	" override to create a different kind of splash window"
					stereotype 	"virtual"
					parameters 	(list Parameters
					    (object Parameter "nIDRes"
						quid       	"3C74E3E60301"
						type       	"UINT")
					    (object Parameter "duration"
						quid       	"3C74E3E60302"
						type       	"UINT")
					    (object Parameter "flags"
						quid       	"3C74E3E60303"
						type       	"WORD"))
					result     	"CWnd*"
