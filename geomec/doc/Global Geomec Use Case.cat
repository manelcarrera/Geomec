    logical_models 	(list unit_reference_list
	(object UseCase "Exit Geomec"
	    quid       	"3A07B88E02B9"
	    documentation 	
|If the model is dirty (due to calculation or other) then ask for saving on closing Geomec or opening a new filosfile or starting a NewModel.  If user not want to save the filosfile then the opened filosfile is unchanged.
|A copy of the filosfile in a tempfilesdir is made during opening and restored to the original file if the user does not want to save.
| 
	    
	    external_docs 	(list external_doc_list
		(object external_doc
		    external_doc_path 	"F:\\lnbx\\OR ICT.dot")))
	(object UseCase "New Model"
	    quid       	"3A0184FB00F7"
	    documentation 	"If the user wants to start Diana on a new created model ( not saved yet) then a temporay filosfile is created in the tempfilesdir. If the user want to save the file then this temporary filosfile is copied to the user specified folder and filename.")
	(object UseCase "Open Filos File"
	    quid       	"3A01846403AD"
	    documentation 	"A copy of the filosfile in a tempfilesdir is made during opening and restored to the original file if the user does not want to save.")
	(object UseCase "Save Filos File"
	    quid       	"3A0185AA0384")
	(object UseCase "Save Filos File As"
	    quid       	"3A0185F8030E")
	(object UseCase "Set Global Geomec parameters"
	    quid       	"3A2E553D02A4"
