sharefiles()
{
	# -- share
	mkdir $1

	DIASLIB=$DIASHARE/lib
	DIASRC=$DIASHARE/src

	# -- share/lib
	SD=$DIASHARE/lib
	TD=$1/lib
	mkdir $TD
	cf DI_ERROR.DAT
	cf femsys.ini
	cf filoscap
	cf geoclass.res
	cf matclass.res

	# -- share/lib/ElmTyp
	mkdir $1/lib/ElmTyp
	cp $DIASLIB/ElmTyp/* $1/lib/ElmTyp

	# -- share/src
	mkdir $1/src

	# -- share/src/include
	SD=$DIASRC/include
	TD=$1/src/include
	mkdir $TD
	cf BoundBox.h
	cf d_cpptypes.h
	cf DiaAssert.h
	cf DiaValueVector.h
	cf DianaVersionInfo.h
	cf DiMalloc.h
	cf fnames.dat
	cf fort.h
	cf lbci.h
	cf lbcp.h
	cf lbcx.h
	cf lbdc.h
	cf lbel.h
	cf lbfl.h
	cf lbgc.h
	cf lbgs.h
	cf RBTree.h
	cf Set.h
	cf Utils.h

	# -- share/src/ap
	mkdir $1/src/ap
	cp $DIASRC/ap/*.txt $1/src/ap

	# -- share/src/dc
	mkdir $1/src/dc
	cp $DIASRC/dc/*.txt $1/src/dc

	# -- share/src/in
	mkdir $1/src/in
	cp $DIASRC/in/*.txt $1/src/in

	# -- share/src/lb
	mkdir $1/src/lb
	cp $DIASRC/lb/*.txt $1/src/lb

	# -- share/src/lb/fl51
	SD=$DIASRC/lb/fl51
	TD=$1/src/lb/fl51
	mkdir $TD
	cf ds.h
	cf filos.h
	cf flut.h

	# -- share/src/lb/gc51/classes/include
	mkdir $1/src/lb/gc51
	mkdir $1/src/lb/gc51/classes
	mkdir $1/src/lb/gc51/classes/include
	cp $DIASRC/lb/gc51/classes/include/*.h $1/src/lb/gc51/classes/include/.

	# -- share/src/ls
	mkdir $1/src/ls
	cp $DIASRC/ls/*.txt $1/src/ls

	# -- share/src/nl
	mkdir $1/src/nl
	cp $DIASRC/nl/*.txt $1/src/nl

	# -- share/src/pf
	mkdir $1/src/pf
	cp $DIASRC/pf/*.txt $1/src/pf

	# -- share/src/po
	mkdir $1/src/po
	cp $DIASRC/po/*.txt $1/src/po

	# -- share/src/so
	mkdir $1/src/so
	cp $DIASRC/so/*.txt $1/src/so
}


intelfiles()
{
	mkdir $1

	cp /opt/intel/compilers_and_libraries/linux/lib/intel64/*.so $1/.
	cp /opt/intel/compilers_and_libraries/linux/lib/intel64/*.so.* $1/.
	cp /opt/intel/compilers_and_libraries/linux/mkl/lib/intel64/*.so $1/.
}

haspfiles()
{
	mkdir $1

	cp /opt/SafeNet/LDK741/C/libhasp_linux_x86_64_3659.so $1/.
}

cf()
{
	# copy file from $SD to $TD
	if [ -e $SD/$1 ]; then
		cp "$SD/$1" "$TD"
	else
		echo "cannot copy $SD/$1 to $TD"
	fi
}

cfw()
{
	# copy framework include directory
	mkdir $TD/$1
	mkdir $TD/$1/include
	cp $SD/$1/include/*.h $TD/$1/include
}

cff()
{
	# copy file from $SD to $TD
	if [ -e $SD/$1 ]; then
		cp $SD/$1 "$TD"
	elif [ -e $SD/$1.* ]; then
		cp $SD/$1.* "$TD"
	else
		echo "cannot copy $SD/$1.* or $SD/$1 to $TD"
	fi
}

# -- $1 is diana root dir
if [ "$1" == "" ]; then Usage; fi
# -- $2 is diana share dir
if [ "$2" == "" ]; then Usage; fi
# -- $3 is target dir
if [ "$3" == "" ]; then Usage; fi

DIAROOT="$1"
DIASHARE="$2"
TARGET="$3"

if [ -e $3/diana ]; then
	rm -rf $3/diana
fi

binfiles $3/diana release
binfiles $3/diana debug
sharefiles $3/diana/share
intelfiles $3/diana/intel
haspfiles $3/diana/hasp

original=`pwd`
cd $3
tar -cjf diana.tar.bz2 diana
cd $original
original=

rm -rf $3/diana

exit 0
