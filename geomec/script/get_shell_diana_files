#!/bin/bash

Usage()
{
	# -- DOS batch scripts escape using ^ character
	echo "Usage: $0 <diana root dir> <diana share dir>"
	pad=$(printf '%0.1s' " "{1..60})
	script=$0
	printf "       %*.*s" 0 $((${#script} + 1)) "$pad"
	printf "%s\n" "<target directory>"
	echo "       A directory named 'diana' will be created under" \
	     "<target directory>"
	exit 1
}

