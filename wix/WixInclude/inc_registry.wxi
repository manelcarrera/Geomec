    <!-- '.gm4' files opened with 'geomec_selector.exe' -->
    <RegistryKey Root="HKCR" Key=".gm4">
      <RegistryValue Value="Geomec4.Document" Type="string" />
    </RegistryKey>

    <RegistryKey Root="HKCR" Key="Geomec4.Document">

      <RegistryValue Value="GEOMEC 4 Project" Type="string" />

      <RegistryKey Key="DefaultIcon">
        <RegistryValue Value="&quot;[INSTALLDIR]geomec_selector.exe&quot;,0" Type="string" />
      </RegistryKey>

      <RegistryKey Key="shell">
        <RegistryKey Key="open">
          <RegistryKey Key="command">
            <RegistryValue Value="&quot;[INSTALLDIR]geomec_selector.exe&quot; &quot;%1&quot;" Type="string" />
          </RegistryKey>
        </RegistryKey>
      </RegistryKey>

    </RegistryKey>

    <!-- '.gm5' files opened with 'geomec_selector.exe' -->
    <RegistryKey Root="HKCR" Key=".gm5">
      <RegistryValue Value="Geomec5.Document" Type="string" />
    </RegistryKey>

    <RegistryKey Root="HKCR" Key="Geomec5.Document">

      <RegistryValue Value="GEOMEC 5 Project" Type="string" />

      <RegistryKey Key="DefaultIcon">
        <RegistryValue Value="&quot;[INSTALLDIR]geomec_selector.exe&quot;,0" Type="string" />
      </RegistryKey>

      <RegistryKey Key="shell">
        <RegistryKey Key="open">
          <RegistryKey Key="command">
            <RegistryValue Value="&quot;[INSTALLDIR]geomec_selector.exe&quot; &quot;%1&quot;" Type="string" />
          </RegistryKey>
        </RegistryKey>
      </RegistryKey>
      
    </RegistryKey>

