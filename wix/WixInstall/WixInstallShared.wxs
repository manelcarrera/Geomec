              <File Id="GVTDatamanager.dll" Source="$(var.GVT)\GVTDatamanager.dll" />
              <File Id="Utils.dll" Source="$(var.GVT)\Utils.dll" />
              <File Id="gvt_QtCore4.dll" Name="QtCore4.dll" Source="$(var.GVT)\QtCore4.dll" />
              <File Id="gvt_QtGui4.dll" Name="QtGui4.dll" Source="$(var.GVT)\QtGui4.dll" />
              <File Id="Sp.dll" Source="$(var.GVT)\Sp.dll" />
              <File Id="SpData.dll" Source="$(var.GVT)\SpData.dll" />
              <File Id="SpMessage.dll" Source="$(var.GVT)\SpMessage.dll" />
              <File Id="SpShell.dll" Source="$(var.GVT)\SpShell.dll" />
              <File Id="SpUnit.dll" Source="$(var.GVT)\SpUnit.dll" />
              <File Id="SpUtil.dll" Source="$(var.GVT)\SpUtil.dll" />
              <File Id="gvt_libifcoremd.dll" Name="libifcoremd.dll" Source="$(var.GVT)\libifcoremd.dll" />
              <File Id="gvt_libmmd.dll" Name="libmmd.dll" Source="$(var.GVT)\libmmd.dll" />
              <File Id="pcre.dll" Source="$(var.GVT)\pcre.dll" />
              <File Id="pcreposix.dll" Source="$(var.GVT)\pcreposix.dll" />
              <File Id="pthreadVC2.dll" Source="$(var.GVT)\pthreadVC2.dll" />
